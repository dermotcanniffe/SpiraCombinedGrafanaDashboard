{
  "title": "Grafana Library Panel (Classic Format)",
  "description": "JSON Schema for Grafana library panel files in classic panel format",
  "type": "object",
  "required": ["name", "type", "title", "datasource", "targets", "fieldConfig", "options", "gridPos"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "datasource": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["refId"],
        "properties": {
          "refId": { "type": "string" },
          "datasource": { "type": "object" },
          "type": { "type": "string" },
          "parser": { "type": "string" },
          "source": { "type": "string" },
          "url": { "type": "string" },
          "format": { "type": "string" },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "selector": { "type": "string" },
                "text": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "options": { "type": "object" }
        }
      }
    },
    "fieldConfig": {
      "type": "object",
      "required": ["defaults"],
      "properties": {
        "defaults": { "type": "object" },
        "overrides": { "type": "array" }
      }
    },
    "options": {
      "type": "object"
    },
    "gridPos": {
      "type": "object",
      "required": ["h", "w", "x", "y"],
      "properties": {
        "h": { "type": "integer", "minimum": 1 },
        "w": { "type": "integer", "minimum": 1, "maximum": 24 },
        "x": { "type": "integer", "minimum": 0, "maximum": 23 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "noDataMessage": {
      "type": "string"
    },
    "pluginVersion": {
      "type": "string"
    }
  }
}
