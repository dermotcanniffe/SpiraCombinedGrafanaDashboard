      "requirements-status": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "Spira-OData",
                        "type": "yesoreyeram-infinity-datasource"
                      },
                      "group": "infinity",
                      "kind": "DataQuery",
                      "spec": {
                        "type": "json",
                        "parser": "backend",
                        "source": "url",
                        "url": "https://internal-dermot.spiraservice.net/api/odata/Requirements",
                        "format": "table",
                        "columns": [
                          { "selector": "RequirementId", "text": "RequirementId", "type": "number" },
                          { "selector": "RequirementStatusId", "text": "RequirementStatusId", "type": "number" }
                        ]
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Breakdown of requirements by status (Requested, In Progress, Developed, Tested)",
          "id": 2,
          "links": [],
          "title": "Requirements Status",
          "vizConfig": {
            "group": "piechart",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "noValue": "No data"
                },
                "overrides": [
                  {
                    "matcher": { "id": "byValue", "options": { "op": "eq", "value": 1 } },
                    "properties": [{ "id": "displayName", "value": "Requested" }]
                  },
                  {
                    "matcher": { "id": "byValue", "options": { "op": "eq", "value": 2 } },
                    "properties": [{ "id": "displayName", "value": "In Progress" }]
                  },
                  {
                    "matcher": { "id": "byValue", "options": { "op": "eq", "value": 5 } },
                    "properties": [{ "id": "displayName", "value": "Developed" }]
                  },
                  {
                    "matcher": { "id": "byValue", "options": { "op": "eq", "value": 7 } },
                    "properties": [{ "id": "displayName", "value": "Tested" }]
                  }
                ]
              },
              "options": {
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "",
                  "values": true
                },
                "pieType": "pie",
                "tooltip": { "mode": "single", "sort": "none" },
                "legend": { "displayMode": "list", "placement": "right", "showLegend": true }
              }
            },
            "version": "13.0.1"
          }
        }
      },
      "test-execution": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "Spira-OData",
                        "type": "yesoreyeram-infinity-datasource"
                      },
                      "group": "infinity",
                      "kind": "DataQuery",
                      "spec": {
                        "type": "json",
                        "parser": "backend",
                        "source": "url",
                        "url": "https://internal-dermot.spiraservice.net/api/odata/TestRuns",
                        "format": "table",
                        "columns": [
                          { "selector": "TestRunId", "text": "TestRunId", "type": "number" },
                          { "selector": "ExecutionStatusId", "text": "ExecutionStatusId", "type": "number" }
                        ]
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Breakdown of test run results by execution status (Passed, Failed, Blocked, Not Run)",
          "id": 3,
          "links": [],
          "title": "Test Execution Results",
          "vizConfig": {
            "group": "piechart",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "noValue": "No data"
                },
                "overrides": [
                  {
                    "matcher": { "id": "byValue", "options": "1" },
                    "properties": [
                      { "id": "displayName", "value": "Failed" },
                      { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
                    ]
                  },
                  {
                    "matcher": { "id": "byValue", "options": "2" },
                    "properties": [
                      { "id": "displayName", "value": "Passed" },
                      { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
                    ]
                  },
                  {
                    "matcher": { "id": "byValue", "options": "3" },
                    "properties": [
                      { "id": "displayName", "value": "Not Run" },
                      { "id": "color", "value": { "fixedColor": "gray", "mode": "fixed" } }
                    ]
                  },
                  {
                    "matcher": { "id": "byValue", "options": "5" },
                    "properties": [
                      { "id": "displayName", "value": "Blocked" },
                      { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
                    ]
                  }
                ]
              },
              "options": {
                "reduceOptions": {
                  "values": true,
                  "calcs": [],
                  "fields": "/^ExecutionStatusId$/"
                },
                "pieType": "pie",
                "tooltip": { "mode": "single", "sort": "none" },
                "legend": { "displayMode": "list", "placement": "right" },
                "displayLabels": ["percent"]
              }
            },
            "version": "13.0.1"
          }
        }
      },
